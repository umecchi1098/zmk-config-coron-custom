/* coron.keymap */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

// レイヤー番号は下のkeymapノードの並び順と揃え、切替先にはこの名前を使う。
#define BASE     0
#define MOUSE    1
#define LOWER    2
#define MID      3
#define RAISE    4
#define SCROLL   5
#define ADJUST   6

// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

// タップでは文字を入力し、200ms以上の長押しではレイヤーを切り替える。
// torabo-tsukiと同じ標準Layer-Tapを使い、英数・かなで他レイヤーを強制解除しない。
&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

// PMW3610内蔵のレイヤー操作を止め、下のZMK標準入力プロセッサへ一本化する。
// センサーの取付方向はcoron_R.confのORIENTATION_180で補正済みなので、通常移動は反転しない。
&trackball {
    automouse-layer = <0>;
    scroll-layers = <>;
};

&trackball_listener {
    // 最後のボール入力から500msの間、Mouseレイヤーを有効にする。
    input-processors = <&auto_mouse_layer MOUSE 500>;

    scroller {
        layers = <SCROLL>;
        // 従来のcoronと同じスクロール方向にするため、縦方向だけを反転する。
        // 横方向は従来のINVERT_SCROLL_X=yと同じ正方向。1/64はtoraboと同じ初期倍率。
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT
                            &zip_xy_scaler 1 64
                            &zip_xy_to_scroll_mapper>;
        // スクロール中も上のAMLタイマーを更新し、解除直後のMouse操作へ戻れるようにする。
        process-next;
    };
};

/ {
    // 文字入力直後150msは自動切替を抑制する。
    // J/K/L/;（位置21〜24）はクリックとScroll用なので、押してもAMLを解除しない。
    // それ以外のキーを押したらAMLを解除して、通常の文字入力へ戻る。
    /omit-if-no-ref/ auto_mouse_layer: auto_mouse_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <150>;
        excluded-positions = <21 22 23 24>;
    };

    // Mid（Space長押し）とRaise（かな長押し）の同時押しで設定レイヤーへ入る。
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <MID RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 各レイヤーは上から12/14/14/11キー。行内は左外側から右外側の順。
        // 最下段の左7キーはCtrl/Win/Alt/Win+Tab/Lower・英数/Mid・Space/Raise・かな。
        // 中央ホーム段の左にスクリーンショット、右に@を置き、右下2キーは^と¥にする。
        // エンコーダーは全レイヤーでPgUp/PgDnに揃える。
        // 通常入力。coron独自のスクリーンショット操作を中央左に残す。
        base_layer {
            display-name = "Base";
            bindings = <
                &kp TAB    &kp Q         &kp W         &kp E         &kp R              &kp T                                                  &kp Y           &kp U          &kp I             &kp O              &kp P          &kp MINUS
                &kp ESC    &kp A         &kp S         &kp D         &kp F              &kp G          &kp LS(LG(S))          &kp JP_AT        &kp H           &kp J          &kp K             &kp L              &kp SEMI       &kp JP_COLON
                &kp LSHFT  &kp Z         &kp X         &kp C         &kp V              &kp B          &kp JP_LBRACKET        &kp JP_RBRACKET  &kp N           &kp M          &kp COMMA         &kp DOT            &kp FSLH       &kp INTERNATIONAL_1
                &kp LCTRL  &kp LWIN      &kp LEFT_ALT  &kp LG(TAB)   &lt LOWER JP_EISU  &lt MID SPACE  &lt RAISE JP_KANA      &kp BACKSPACE    &kp RETURN                                                          &kp JP_CARET   &kp JP_YEN
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // ボール操作で自動的に有効。J/K/Lで左/右/中クリック、;長押しでScroll。
        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &trans     &trans        &trans        &trans        &trans             &trans                                                 &trans          &trans         &trans            &trans             &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &trans          &mkp LCLK      &mkp RCLK         &mkp MCLK          &mo SCROLL     &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &trans          &trans         &trans            &trans             &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &trans                                                              &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // 英数キーを長押しして数字・記号を入力する。
        lower_layer {
            display-name = "Lower";
            bindings = <
                &trans     &kp LS(N1)    &kp LS(N2)    &kp LS(N3)    &kp LS(N4)         &kp LS(N5)                                             &kp LS(N6)      &kp LS(N7)     &kp LS(N8)        &kp LS(N9)         &kp LS(N0)     &trans
                &trans     &kp N1        &kp N2        &kp N3        &kp N4             &kp N5         &trans                 &trans           &kp LEFT_BRACE  &kp MINUS      &kp EQUAL         &kp RIGHT_BRACE    &kp COLON      &kp JP_AT
                &trans     &kp N6        &kp N7        &kp N8        &kp N9             &kp N0         &kp JP_CARET           &kp JP_YEN       &kp LS(MINUS)   &kp LS(EQUAL)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &kp DEL          &kp RETURN                                                          &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // Spaceを長押しして数字・矢印・Home・Endを使う。
        mid_layer {
            display-name = "Mid";
            bindings = <
                &trans     &kp N1        &kp N2        &kp N3        &kp N4             &kp N5                                                 &trans          &trans         &kp UP            &trans             &trans         &trans
                &trans     &kp N6        &kp N7        &kp N8        &kp N9             &kp N0         &trans                 &trans           &kp HOME        &kp LEFT       &kp DOWN          &kp RIGHT          &kp END        &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &trans          &trans         &trans            &trans             &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &kp DEL          &kp RETURN                                                          &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // かなキーを長押ししてF1〜F12とテンキーを使う。
        raise_layer {
            display-name = "Raise";
            bindings = <
                &trans     &kp F1        &kp F2        &kp F3        &kp F4             &kp F5                                                 &kp KP_N7       &kp KP_N8      &kp KP_N9         &kp KP_MULTIPLY    &kp KP_DIVIDE  &trans
                &trans     &kp F6        &kp F7        &kp F8        &kp F9             &kp F10        &trans                 &trans           &kp KP_N4       &kp KP_N5      &kp KP_N6         &kp KP_PLUS        &kp KP_MINUS   &trans
                &trans     &kp F11       &kp F12       &trans        &trans             &trans         &trans                 &kp KP_N0        &kp KP_N1       &kp KP_N2      &kp KP_N3         &kp DOT            &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &kp BACKSPACE    &kp RETURN                                                          &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // ボールを縦横スクロールへ変換し、J/Lで戻る・進む。
        scroll_layer {
            display-name = "Scroll";
            bindings = <
                &trans     &trans        &trans        &trans        &trans             &trans                                                 &trans          &trans         &trans            &trans             &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &trans          &mkp MB4       &trans            &mkp MB5           &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &trans          &trans         &trans            &trans             &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &trans                                                              &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // MidとRaiseの同時長押しでBluetoothと出力先を設定する。
        adjust_layer {
            display-name = "Adjust";
            bindings = <
                &trans     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3       &bt BT_SEL 4                                           &bt BT_CLR_ALL  &trans         &trans            &trans             &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &bt BT_CLR      &trans         &trans            &trans             &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &out OUT_TOG    &trans         &trans            &trans             &trans         &trans
                &trans     &trans        &trans        &trans        &trans             &trans         &trans                 &trans           &trans                                                              &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

    };
};
